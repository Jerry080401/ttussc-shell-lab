# PVE LXC 部署的設定，和 NetBird 版的 .env 分開。複製成 shell-lab.env 再修改：
#   cp deploy/pve/shell-lab.env.example deploy/pve/shell-lab.env
#   chmod 600 deploy/pve/shell-lab.env
# shell-lab.env 已被 .gitignore 擋掉。值不要加引號，也不要有空白。
# labctl 會檢查每個值；留白或刪掉的設定用程式裡的預設值，不認得的設定會直接報錯。

# ---- make 用 ----
# 在自己電腦上用 make pve-* 時，登入 PVE 主機的 帳號@主機。不是 root 的話，這個帳號要能 sudo。
PVE_SSH=

# ---- 題目 ----
# 代號，題目資料由它和 LAB_SECRET 推導。
COHORT=shell-lab
# 人數，最多 99。學生 ID 是 student01 到 studentNN。
STUDENT_COUNT=20
# 產生每個人題目資料用的密鑰，64 位十六進位。make pve-env 會自動產生。
LAB_SECRET=
# flag 的前綴，例如 flag 會得到 flag{...}。
FLAG_PREFIX=flag

# ---- 容器系統 ----
# ubuntu-24.04 或 ubuntu-26.04，GUEST_TEMPLATE 要是同一個版本的 LXC 樣板。查樣板名稱：
#   pveam available --section system | grep ubuntu
GUEST_OS=ubuntu-24.04
GUEST_TEMPLATE=ubuntu-24.04-standard_24.04-2_amd64.tar.zst
GUEST_LOCALE=zh_TW.UTF-8
GUEST_TIMEZONE=Asia/Taipei
# 使用者在容器裡能不能用 sudo。題目都用不到，建議 false。
STUDENT_SUDO=false
# 另外不讓容器連的網段，用逗號分隔。內部網路用的是公網位址時要填。
PROTECTED_NETWORKS=

# ---- PVE 資源 ----
# 樣板所在的儲存，以及容器根目錄的儲存。
TEMPLATE_STORAGE=local
STORAGE=local-lvm
# 第一台的 CTID，依序加一。這段範圍內不能有別的容器或 VM。
CTID_START=201
CT_CORES=1
CT_MEMORY_MB=1024
CT_SWAP_MB=512
CT_DISK_GB=8
# 容器用的 DNS，留白沿用 PVE 主機的設定。
CT_NAMESERVER=

# ---- 容器網路 ----
# 給容器用的 NAT 橋接和私有網段。第一個位址給橋接，容器從第二個開始。
NAT_BRIDGE=vmbr1
NAT_SUBNET=10.10.10.0/24

# ---- 連線方式 ----
# 目前只有 portforward：主機對外介面的一個埠對應一台容器的 22 埠。
ACCESS_MODE=portforward
# 接收連線的主機介面。
PORTFORWARD_IFACE=vmbr0
# 連線指令裡的位址。留白會取 PORTFORWARD_IFACE 上的 IPv4；主機前面還有一層 NAT 時填外面的位址或網域。
PORTFORWARD_ADDRESS=
# 第一台的埠，依序加一。
PORTFORWARD_PORT_START=22001
# 允許連入的來源網段，用逗號分隔，必填。0.0.0.0/0 表示不限制來源。
PORTFORWARD_SOURCES=
