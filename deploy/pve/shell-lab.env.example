# shell-lab-setup.sh 的設定。複製成 shell-lab.env 再修改：
#   cp shell-lab.env.example shell-lab.env
# shell-lab.env 已被 .gitignore 擋掉。值不要加引號，也不要有空白。
# 沒填的變數會用腳本裡的預設值（就是下面寫的值）。

# ---- make 用 ----
# 在自己電腦上用 make pve-* 時，登入 PVE 主機的 帳號@主機（可以是 ~/.ssh/config 裡的名稱）。
# 不是 root 的話，這個帳號要能 sudo。直接在 PVE 主機上跑腳本時不需要。
PVE_SSH=

# ---- 對外連線 ----
# PVE 主機連外的介面，轉發規則只對從這個介面進來的連線生效。
WAN_IFACE=vmbr0
# 使用者 ssh 時連的位址，只用在連線資訊檔。留白會取 WAN_IFACE 上的 IPv4；
# 主機前面還有一層 NAT 時，要填外面看得到的位址。
PUBLIC_IP=
# 允許連入的來源網段，多個用逗號分隔，例如 198.51.100.0/24,203.0.113.7。
# 必填。填 0.0.0.0/0 等於全開，請收斂到實際會連線的範圍。
ALLOWED_SOURCE_CIDR=

# ---- NAT 網段 ----
# 給容器用的橋接名稱，不能和既有的橋接重複。
NAT_BRIDGE=vmbr1
# 橋接本身的位址和前綴長度，也是容器的預設閘道。
NAT_ADDRESS=10.10.10.1/24
# 第一台容器的位址 = 網段起點 + CT_IP_OFFSET（預設 10.10.10.101 起）。
CT_IP_OFFSET=101

# ---- 數量與編號 ----
# 容器數量。帳號、主機名稱從 01 編到 COUNT。
COUNT=20
# 第一台的 CTID，依序加一。這段範圍內不能有別的容器或 VM。
CTID_START=201
# 第一台的對外連接埠，依序加一。
PORT_START=22001

# ---- 樣板與儲存 ----
# LXC 樣板所在的儲存和檔名。版本號更新時改 TEMPLATE，可用
#   pveam available --section system | grep ubuntu-24.04
# 查目前的名稱。
TEMPLATE_STORAGE=local
TEMPLATE=ubuntu-24.04-standard_24.04-2_amd64.tar.zst
# 容器根目錄放在哪個儲存。
STORAGE=local-lvm

# ---- 容器規格 ----
CT_CORES=1
CT_MEMORY_MB=1024
CT_SWAP_MB=512
CT_DISK_GB=8
# 容器用的 DNS，留白沿用 PVE 主機的設定。
CT_NAMESERVER=
# 主機名稱前綴，例如 shell-lab-01。stop/start/destroy 只會動主機名稱相符的容器。
CT_HOSTNAME_PREFIX=shell-lab-

# ---- 帳號 ----
# 帳號前綴，例如 user01。
USER_PREFIX=user
# 帳號要不要加入 sudo 群組（true/false）。
USER_SUDO=true
# 隨機密碼長度（8 到 64）。
PASSWORD_LENGTH=12

# ---- 產出檔與主機上的檔案 ----
# 連線資訊檔（含明碼密碼）。相對路徑以腳本所在目錄為準。
# 改名的話請保留 -credentials.txt 結尾，才會被 .gitignore 擋掉。
CRED_FILE=shell-lab-credentials.txt
# 開機時載入轉發規則的腳本，以及放規則的 iptables chain。
FORWARD_HOOK=/etc/network/if-up.d/shell-lab-portforward
DNAT_CHAIN=SHELL_LAB_DNAT
