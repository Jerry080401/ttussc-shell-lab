[Unit]
Description=shell lab VM isolation rules (nftables table inet shell_lab)
Before=incus.service incus-startup.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/shell-lab/lab-firewall.nft
ExecStartPost=-/usr/local/sbin/shell-lab-gateway-sync

[Install]
WantedBy=multi-user.target
